# start.sh copia este archivo a .env la primera vez y genera contraseñas nuevas.

# 0 = la web lee de MySQL (sistema completo) | 1 = la web usa datos de ejemplo sin base
USE_MOCK=0

WEB_PORT=8080
# Acceso a la web: start.sh genera una clave obligatoria.
WEB_USER=admin
WEB_PASSWORD=
# Activar (1) cuando el acceso web sea exclusivamente HTTPS.
WEB_COOKIE_SECURE=0

# Base de datos (la comparten la web y el worker)
DB_NAME=snmp_monitor
DB_USER=snmp
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# 1 = al crear el volumen por primera vez, carga 2 servidores y 24 h de mediciones inventadas
LOAD_DEMO_DATA=0

# Worker
SNMP_TIMEOUT=3
SNMP_RETRIES=1
LOG_LEVEL=INFO
